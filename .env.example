# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SCOPES=read_orders,write_orders,read_products,write_products,read_customers

# Sessions DB
DATABASE_URL=file:./prisma/sessions.db

# Encryption key for stored third-party credentials (32 bytes, hex-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Meta Ads OAuth (Facebook for Developers app)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v19.0
